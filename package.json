{
  "name": "serverless-kms-alias",
  "version": "5.0.87",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serverless-plugins/serverless-kms-alias.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "check:types": "tsc --noEmit",
    "lint:format": "vp fmt",
    "lint:markdown": "markdownlint '*.md' '!(node_modules|dist)/**/*.md' --config=.github/linters/.markdown-lint.yml --fix",
    "lint:code": "vp lint --fix",
    "lint": "pnpm run \"/^lint:.*/\"",
    "prepublishOnly": "vp pack",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1085.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-config-decent": "4.2.38",
    "eslint-plugin-jsdoc": "63.0.13",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "71.1.0",
    "markdownlint-cli": "0.49.0",
    "oxlint-plugin-eslint": "1.73.0",
    "publint": "0.3.21",
    "semantic-release": "25.0.6",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0+sha512.RGP2X9gO2A1pvB1L8WPulPYFxzgPwxi7Wy6+FfjNEtScUaTVnpUbQB52TTtsp1HL9RvFDtcAGmvLSTXmhMNIgg=="
}
